{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "stocks-df"
		},
		"db_ls_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'db_ls'"
		},
		"sf_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sf_ls'"
		},
		"LS_ApiCountries_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://www.apicountries.com/"
		},
		"db_ls_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1130-190835-wa24cnwg"
		},
		"marketstack_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "http://api.marketstack.com/v2/"
		},
		"sf_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "GOLD"
		},
		"sf_ls_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ACCOUNTADMIN"
		},
		"sf_ls_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "KUWUDZZ-NU62337.snowflakecomputing.com"
		},
		"stocks_sg_ls_properties_typeProperties_serviceEndpoint": {
			"type": "string",
			"defaultValue": "https://stockssg.blob.core.windows.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_ApiCountries')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('LS_ApiCountries_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/db_ls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-2936311793171566.6.azuredatabricks.net",
					"accessToken": {
						"type": "SecureString",
						"value": "[parameters('db_ls_accessToken')]"
					},
					"existingClusterId": "[parameters('db_ls_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/marketstack_ls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "RestService",
				"typeProperties": {
					"url": "[parameters('marketstack_ls_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sf_ls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SnowflakeV2",
				"typeProperties": {
					"authenticationType": "Basic",
					"accountIdentifier": "KUWUDZZ-NU62337",
					"user": "HARINEERUK",
					"database": "[parameters('sf_ls_properties_typeProperties_database')]",
					"warehouse": "COMPUTE_WH",
					"role": "[parameters('sf_ls_properties_typeProperties_role')]",
					"host": "[parameters('sf_ls_properties_typeProperties_host')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sf_ls_password')]"
					},
					"useUtcTimestamps": false
				},
				"version": "1.1"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/stocks_sg_ls')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"serviceEndpoint": "[parameters('stocks_sg_ls_properties_typeProperties_serviceEndpoint')]",
					"accountKind": "StorageV2"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pipeline1')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/snowflake_upload')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "snowflake_upload_notebook",
						"type": "DatabricksNotebook",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Shared/Snowflake_upload"
						},
						"linkedServiceName": {
							"referenceName": "db_ls",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2025-12-01T17:09:13Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/db_ls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/MarketStack_DS')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "marketstack_ls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"symbol": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "RestResource",
				"typeProperties": {
					"relativeUrl": {
						"value": "eod?access_key=49f2a298972e670edc6efd04e2607aca&symbols=@{dataset().symbol}&limit=1",
						"type": "Expression"
					}
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/marketstack_ls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/MarkettoBlob_ds')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "stocks_sg_ls",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"container": {
						"type": "string"
					},
					"filename": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": {
							"value": "@dataset().filename",
							"type": "Expression"
						},
						"container": {
							"value": "@dataset().container",
							"type": "Expression"
						}
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/stocks_sg_ls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/countries_ds')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ApiCountries",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": "/countries"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ApiCountries')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/sf_ds')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sf_ls",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "SnowflakeV2Table",
				"schema": [],
				"typeProperties": {
					"schema": "GOLD_DB",
					"table": "GOLD"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/sf_ls')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/daily_pipe')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "daily_cd",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "RestSource",
								"httpRequestTimeout": "00:01:40",
								"requestInterval": "00.00:00:00.010",
								"requestMethod": "GET",
								"paginationRules": {
									"supportRFC5988": "true"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "MarketStack_DS",
								"type": "DatasetReference",
								"parameters": {
									"symbol": "GOOGL"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "MarkettoBlob_ds",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"filename": {
										"value": "dailystockprice@{formatDateTime(addDays(utcNow(), -1),'yyyyMMdd')}",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2025-11-29T21:02:48Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/MarketStack_DS')]",
				"[concat(variables('factoryId'), '/datasets/MarkettoBlob_ds')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/market_to_blob_pipe')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "marketapi",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "RestSource",
								"httpRequestTimeout": "00:01:40",
								"requestInterval": "00.00:00:00.010",
								"requestMethod": "GET",
								"paginationRules": {
									"supportRFC5988": "true"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "MarketStack_DS",
								"type": "DatasetReference",
								"parameters": {
									"symbol": "GOOGL"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "MarkettoBlob_ds",
								"type": "DatasetReference",
								"parameters": {
									"container": "raw",
									"filename": "googlepast"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2025-11-29T17:45:30Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/MarketStack_DS')]",
				"[concat(variables('factoryId'), '/datasets/MarkettoBlob_ds')]"
			]
		}
	]
}